{
	"name": "pl_ingest_visualcrossing_landing_dev_history",
	"properties": {
		"activities": [
			{
				"name": "Copy_visualcrossing_to_landing",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "set_date_list",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_jason_visualcrossing_src_dev",
						"type": "DatasetReference",
						"parameters": {
							"city": {
								"value": "@pipeline().parameters.city",
								"type": "Expression"
							},
							"date": {
								"value": "@variables('date')",
								"type": "Expression"
							},
							"apikey": {
								"value": "@activity('web_get_apikey').output.value",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_json_visualcrossing_landing_dev",
						"type": "DatasetReference",
						"parameters": {
							"city": {
								"value": "@pipeline().parameters.city",
								"type": "Expression"
							},
							"date": {
								"value": "@variables('date')",
								"type": "Expression"
							},
							"file_name": {
								"value": "@tolower (concat(\n    'study_',\n    pipeline().parameters.city,\n    '_',\n    formatDateTime(utcNow(), 'yyyyMMddHHmmss'),\n    '.json'\n))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "web_get_apikey",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-study-dev-wastus2-001.vault.azure.net/secrets/visualcrossing-api-key-dev/4a9e386ac41544a89c90308eff7abbae?api-version=2025-07-01",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net/"
					}
				}
			},
			{
				"name": "set_date_list",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "web_get_apikey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "date_list",
					"value": {
						"value": "@range(0, add(div(sub(ticks(pipeline().parameters.endDate),ticks(pipeline().parameters.startDate)),864000000000),1))",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"city": {
				"type": "string"
			},
			"startDate": {
				"type": "string"
			},
			"endDate": {
				"type": "string"
			}
		},
		"variables": {
			"date": {
				"type": "String"
			},
			"date_list": {
				"type": "Array"
			}
		},
		"folder": {
			"name": "VisualCrossing"
		},
		"annotations": []
	}
}